# --- PostgreSQL (pgAdmin) ---
# Copier ce fichier vers .env puis adapter le mot de passe :
#   cp .env.example .env
DATABASE_URL=postgresql+psycopg://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/dialibatou_db

# --- JWT (mettre une chaine aleatoire longue en production) ---
JWT_SECRET=change_moi_en_production_avec_une_longue_chaine_aleatoire
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# --- Admin cree par seed.py (hash bcrypt en base, jamais en clair) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=dialibatou2024

# --- CORS : frontends autorises (separés par des virgules) ---
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000

# --- Anti-spam formulaire de contact (fenetre glissante d'1 h) ---
# false = illimité (pratique en developp), true = protégé en production
RATE_LIMIT_ENABLED=true
MESSAGES_PER_HOUR_IP=5
MESSAGES_PER_HOUR_EMAIL=3
